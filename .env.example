# 复制本文件为 .env 后按需填写（也可以完全不填，直接在网页「模型中心」里配置）
# 注意：.env 不要提交到 git

# 服务端口（需与 docker-compose.yml 的 ports 左侧一致）
PORT=8787

# 数据目录（Docker 内固定为 /app/data，一般不用改）
WANJIE_DATA_DIR=/app/data

# 可选：默认模型（不填则用模型中心里设为默认的那个）
# WANJIE_LLM_KEY=sk-你的密钥
# WANJIE_LLM_BASE=https://api.deepseek.com/v1
# WANJIE_LLM_MODEL=deepseek-chat
